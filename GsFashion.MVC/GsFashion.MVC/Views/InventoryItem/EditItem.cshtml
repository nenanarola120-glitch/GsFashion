@model GsFashion.Repository.Models.InventoryItem.InventoryItemModel
@{
    ViewData["Title"] = "Edit Inventory Item";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Edit Inventory Item</h3>
    <a asp-action="GetAllItem" class="btn btn-secondary">Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="EditItem" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ItemId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SkuCode" class="form-label"></label>
                    <input asp-for="SkuCode" class="form-control" />
                    <span asp-validation-for="SkuCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">-- Select category --</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Size" class="form-label"></label>
                    <input asp-for="Size" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="BaseRentalPrice" class="form-label"></label>
                    <input asp-for="BaseRentalPrice" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="BaseRentalPrice" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="SecurityDeposit" class="form-label"></label>
                    <input asp-for="SecurityDeposit" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PurchaseCost" class="form-label"></label>
                    <input asp-for="PurchaseCost" type="number" step="0.01" min="0" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Item Image</label>
                    <div class="d-flex align-items-center gap-3">
                        <input type="file" name="imageFile" id="imageFile" accept="image/*" class="form-control" onchange="previewImage(this)" />
                        <img id="imagePreview"
                             src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "#" : Model.ImageUrl)"
                             alt="Preview"
                             style="max-height:80px; border:1px solid #dee2e6; border-radius:4px; @(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")" />
                    </div>
                    <small class="text-muted">Leave blank to keep the current image.</small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="GetAllAsync" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}