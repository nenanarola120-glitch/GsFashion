@model IEnumerable<GsFashion.Repository.Models.InventoryItem.InventoryItemModel>
@{
    ViewData["Title"] = "Inventory Items";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Inventory Items</h3>
    <a asp-action="AddItem" class="btn btn-primary">+ Add Item</a>
</div>

<form asp-action="GetAllItem" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6 col-lg-4">
        <label for="searchingString" class="visually-hidden">Search inventory</label>
        <input id="searchingString" name="searchingString" class="form-control"
               value="@Context.Request.Query["searchingString"]"
               placeholder="Search by SKU, name, color, price, or status" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="GetAllItem" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                @* <th>Photo</th> *@
                <th>SKU</th>
                <th>Name</th>
                <th>Category</th>
                @* <th>Size</th> *@
                <th>Color</th>
                <th>Rent/Day</th>
                <th>Deposit</th>
                <th>Status</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="item-row" style="cursor: pointer;"
                    data-sku="@item.SkuCode"
                    data-name="@item.Name"
                    data-category="@item.CategoryName"
                    data-size="@item.Size"
                    data-color="@item.Color"
                    data-rent="@item.BaseRentalPrice.ToString("N2")"
                    data-deposit="@item.SecurityDeposit.ToString("N2")"
                    data-purchasecost="@item.PurchaseCost.ToString("N2")"
                    data-status="@item.Status"
                    data-image="@item.ImageUrl">
                    @* <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
                        }
                        else
                        {
                            <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="width:48px;height:48px;border-radius:4px;font-size:0.65rem;">No image</div>
                        }
                    </td> *@
                    <td>@item.SkuCode</td>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>
                    @* <td>@item.Size</td> *@
                    <td>@item.Color</td>
                    <td>@item.BaseRentalPrice.ToString("N2")</td>
                    <td>@item.SecurityDeposit.ToString("N2")</td>
                    <td>
                        @{
                            var badgeClass = item.Status switch
                            {
                                            "Available" => "bg-success",
                                            "Rented" => "bg-warning text-dark",
                                            "InWash" => "bg-info text-dark",
                                            "UnderRepair" => "bg-secondary",
                                            "Retired" => "bg-dark",
                                _ => "bg-light text-dark"
                            };
                        }
                        <span class="badge @badgeClass">@item.Status</span>
                    </td>
                    <td onclick="event.stopPropagation();">
                        <div class="d-flex gap-2">
                            <a asp-action="EditItem" asp-route-id="@item.ItemId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteItem" asp-route-id="@item.ItemId" method="post"
                                  onsubmit="return confirm('Delete this item?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-3">No inventory items yet.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Item Detail Modal -->
<div class="modal fade" id="itemDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalItemName">Item Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-5 text-center">
                        <img id="modalItemImage" src="#" alt="Item"
                             class="img-fluid rounded border"
                             style="max-height: 320px; object-fit: cover; display: none;" />
                        @* <div id="modalNoImage" class="bg-light text-muted d-flex align-items-center justify-content-center rounded"
                             style="height: 240px; display: none;">
                            No image available
                        </div> *@
                    </div>
                    <div class="col-md-7">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr><th style="width: 40%;">SKU</th><td id="modalItemSku"></td></tr>
                                <tr><th>Category</th><td id="modalItemCategory"></td></tr>
                                <tr><th>Size</th><td id="modalItemSize"></td></tr>
                                <tr><th>Color</th><td id="modalItemColor"></td></tr>
                                <tr><th>Rent / Day</th><td id="modalItemRent"></td></tr>
                                <tr><th>Security Deposit</th><td id="modalItemDeposit"></td></tr>
                                <tr><th>Purchase Cost</th><td id="modalItemPurchasecost"></td></tr>
                                <tr><th>Status</th><td id="modalItemStatus"></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('itemDetailModal');
            var modal = new bootstrap.Modal(modalEl);

            document.querySelectorAll('.item-row').forEach(function (row) {
                row.addEventListener('click', function () {
                    var data = row.dataset;

                    document.getElementById('modalItemName').textContent = data.name;
                    document.getElementById('modalItemSku').textContent = data.sku;
                    document.getElementById('modalItemCategory').textContent = data.category || '-';
                    document.getElementById('modalItemSize').textContent = data.size || '-';
                    document.getElementById('modalItemColor').textContent = data.color || '-';
                    document.getElementById('modalItemRent').textContent = data.rent;
                    document.getElementById('modalItemDeposit').textContent = data.deposit;
                    document.getElementById('modalItemPurchasecost').textContent = data.purchasecost;
                    document.getElementById('modalItemStatus').textContent = data.status;

                    var img = document.getElementById('modalItemImage');
                    // var noImage = document.getElementById('modalNoImage');

                    if (data.image) {
                        img.src = data.image;
                        img.style.display = 'inline-block';
                        // noImage.style.display = 'none';
                    } else {
                        img.style.display = 'none';
                        // noImage.style.display = 'flex';
                    }

                    modal.show();
                });
            });
        });
    </script>
}
