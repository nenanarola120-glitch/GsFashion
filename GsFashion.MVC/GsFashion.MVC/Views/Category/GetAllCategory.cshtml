@model IEnumerable<GsFashion.Repository.Models.Category.CategoryModel>
@{
    ViewData["Title"] = "Category List";
    // Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Category List</h3>
    <a asp-action="AddCategory" class="btn btn-primary">+ Add Category</a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
            }
            @foreach (var category in Model)
            {
                <tr>
                    <td>@(i++)</td>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="EditCategory" asp-route-id="@category.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteCategory" asp-route-id="@category.CategoryId" method="post"
                                  onsubmit="return confirm('Delete this category?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-3">No categories yet.</td></tr>
            }
        </tbody>
    </table>
</div>