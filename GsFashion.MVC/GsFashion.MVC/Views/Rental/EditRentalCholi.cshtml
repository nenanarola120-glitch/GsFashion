@model GsFashion.Repository.Models.Rental.RentalModel

@{
    ViewData["Title"] = "Edit Rental";

    var customers = ViewBag.Customers as IEnumerable<GsFashion.Repository.Models.Menu.DropDownResponse>;
    var statuses = ViewBag.Statuses as IEnumerable<GsFashion.Repository.Models.Menu.DropDownResponse>;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">Edit Rental #@Model.RentalId</h3>
            <p class="text-muted mb-0">Update rental booking</p>
        </div>
        <a asp-action="GetAllRentalCholiList" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Rental Information</h5>
        </div>

        <div class="card-body">
            <form asp-action="EditRentalCholi" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="RentalId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Customer -->
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer</label>
                        <select asp-for="CustomerId" class="form-select">
                            <option value="">-- Select Customer --</option>
                            @if (customers != null)
                            {
                                foreach (var customer in customers)
                                {
                                    <option value="@customer.Id">@customer.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Start -->
                    <div class="col-md-6">
                        <label asp-for="RentalStartDate" class="form-label">Rental Start Date</label>
                        <input asp-for="RentalStartDate" type="date" class="form-control" />
                    </div>

                    <!-- Expected -->
                    <div class="col-md-6">
                        <label asp-for="ExpectedReturnDate" class="form-label">Expected Return Date</label>
                        <input asp-for="ExpectedReturnDate" type="date" class="form-control" />
                    </div>

                    <!-- Status -->
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Booked">Booked</option>
                            <option value="Active">Active</option>
                            <option value="Returned">Returned</option>
                            <option value="Overdue">Overdue</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <!-- Items -->
                    <div class="col-md-12">
                        <label asp-for="ItemIds" class="form-label">Inventory Item IDs</label>
                        <input asp-for="ItemIds" class="form-control" placeholder="Example: 1,2,5" />
                        <div class="form-text">
                            Enter comma-separated inventory item IDs.
                        </div>
                    </div>

                    <!-- Condition -->
                    <div class="col-md-12">
                        <label asp-for="ConditionOut" class="form-label">Condition Out</label>
                        <textarea asp-for="ConditionOut" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-12">
                        <hr />
                        <h5>Rental Charges</h5>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TotalRentAmount" class="form-label">Total Rent Amount</label>
                        <input asp-for="TotalRentAmount" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SecurityDeposit" class="form-label">Security Deposit</label>
                        <input asp-for="SecurityDeposit" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="LateFee" class="form-label">Late Fee</label>
                        <input asp-for="LateFee" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DamageFee" class="form-label">Damage Fee</label>
                        <input asp-for="DamageFee" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Discount" class="form-label">Discount</label>
                        <input asp-for="Discount" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="GrandTotal" class="form-label">Grand Total</label>
                        <input asp-for="GrandTotal" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AmountPaid" class="form-label">Amount Paid</label>
                        <input asp-for="AmountPaid" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BalanceAmount" class="form-label">Balance Amount</label>
                        <input asp-for="BalanceAmount" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Update Rental
                    </button>
                    <a asp-action="GetAllRentalCholiList" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
