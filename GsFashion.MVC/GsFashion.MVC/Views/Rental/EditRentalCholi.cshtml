@model GsFashion.Repository.Models.Rental.RentalModel

@{
    ViewData["Title"] = "Edit Rental";

    var customers = ViewBag.Customers as IEnumerable<GsFashion.Repository.Models.Menu.DropDownResponse>;
    var statuses = ViewBag.Statuses as IEnumerable<GsFashion.Repository.Models.Menu.DropDownResponse>;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">Edit Rental #@Model.RentalId</h3>
            <p class="text-muted mb-0">Update rental booking</p>
            <h2>Customer : @Model.CustomerFirstName @Model.CustomerLastName</h2>
        </div>
        <a asp-action="GetAllRentalCholiList" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">Selected Choli</h5>
                <small class="text-muted">Remove a choli to cancel only that rental item when you update.</small>
            </div>
            <span id="selectedItemCount" class="badge bg-primary">@Model.InventoryItemModels.Count() Item(s)</span>
        </div>
        <div class="card-body">
            <div id="selectedItemsContainer" class="row g-3">
                @foreach (var item in Model.InventoryItemModels)
                {
                    <div class="col-md-6 col-lg-4" data-item-container="@item.ItemId">
                        <div class="border rounded p-3 bg-light h-100 d-flex justify-content-between gap-3">
                            <div>
                                <strong>@item.SkuCode</strong>
                                <div>@item.Name</div>
                                <small class="text-muted d-block">@(item.CategoryName ?? "-") | Size: @(item.Size ?? "-") | Color: @(item.Color ?? "-")</small>
                                <small class="text-muted">Rent: ₹ @item.BaseRentalPrice.ToString("0.00") | Deposit: ₹ @item.SecurityDeposit.ToString("0.00")</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger remove-item" data-id="@item.ItemId" title="Remove this choli">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div id="noItemsMessage" class="alert alert-warning mb-0 @(Model.InventoryItemModels.Any() ? "d-none" : "")">
                At least one choli must remain in this rental.
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Rental Information</h5>
        </div>

        <div class="card-body">
            <form asp-action="EditRentalCholi" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="RentalId" type="hidden" />
                <input asp-for="CustomerId" type="hidden" />
                <input asp-for="ItemIds" type="hidden" id="ItemIdsHidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Start -->
                    <div class="col-md-6">
                        <label asp-for="RentalStartDate" class="form-label">Rental Start Date</label>
                        <input asp-for="RentalStartDate" type="date" class="form-control" />
                    </div>

                    <!-- Expected -->
                    <div class="col-md-6">
                        <label asp-for="ExpectedReturnDate" class="form-label">Expected Return Date</label>
                        <input asp-for="ExpectedReturnDate" type="date" class="form-control" />
                    </div>


                    <div class="col-12">
                        <hr />
                        <h5>Rental Charges</h5>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TotalRentAmount" class="form-label">Total Rent Amount</label>
                        <input asp-for="TotalRentAmount" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SecurityDeposit" class="form-label">Security Deposit</label>
                        <input asp-for="SecurityDeposit" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="LateFee" class="form-label">Late Fee</label>
                        <input asp-for="LateFee" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DamageFee" class="form-label">Damage Fee</label>
                        <input asp-for="DamageFee" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Discount" class="form-label">Discount</label>
                        <input asp-for="Discount" type="number" step="0.01" min="0" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Update Rental
                    </button>
                    <a asp-action="GetAllRentalCholiList" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const itemIdsHidden = document.getElementById('ItemIdsHidden');
        const selectedItemsContainer = document.getElementById('selectedItemsContainer');
        const noItemsMessage = document.getElementById('noItemsMessage');
        const selectedItemCount = document.getElementById('selectedItemCount');

        function selectedItemIds() {
            return itemIdsHidden.value.split(',').filter(id => id.trim() !== '');
        }

        function refreshSelectedItemState() {
            const count = selectedItemIds().length;
            selectedItemCount.textContent = `${count} Item(s)`;
            noItemsMessage.classList.toggle('d-none', count > 0);
        }

        document.querySelectorAll('.remove-item').forEach(button => {
            button.addEventListener('click', function () {
                const itemId = this.dataset.id;
                const ids = selectedItemIds().filter(id => id !== itemId);

                if (ids.length === 0) {
                    alert('A rental must contain at least one choli. Use Cancel Rental to cancel the complete booking.');
                    return;
                }

                itemIdsHidden.value = ids.join(',');
                document.querySelector(`[data-item-container="${itemId}"]`)?.remove();
                refreshSelectedItemState();
            });
        });

        // A changed rental period needs a fresh availability selection. Keep the
        // current Choli IDs so they remain selected on the Add Rental Choli page.
        const startDate = document.getElementById('RentalStartDate');
        const returnDate = document.getElementById('ExpectedReturnDate');
        const originalStartDate = startDate.value;
        const originalReturnDate = returnDate.value;

        function changeDatesAndSelectCholi() {
            if (!startDate.value || !returnDate.value ||
                (startDate.value === originalStartDate && returnDate.value === originalReturnDate)) {
                return;
            }

            const query = new URLSearchParams({
                itemIds: itemIdsHidden.value,
                rentalStartDate: startDate.value,
                expectedReturnDate: returnDate.value,
                editRentalId: '@Model.RentalId'
            });
            window.location.href = '@Url.Action("AddRentalCholi", "Rental")' + '?' + query.toString();
        }

        startDate.addEventListener('change', changeDatesAndSelectCholi);
        returnDate.addEventListener('change', changeDatesAndSelectCholi);
        refreshSelectedItemState();
    </script>
}
