@model IEnumerable<GsFashion.Repository.Models.Rental.RentalModel>

@{
    ViewData["Title"] = "Rentals";
    var searchingString = ViewBag.SearchingString as string ?? string.Empty;
    var selectedStatus = ViewBag.Status as string ?? string.Empty;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Rentals</h3>
            <p class="text-muted mb-0">Manage rental bookings</p>
        </div>
        <a asp-action="AddRentalCholi" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Rental
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="GetAllRentalCholiList" method="get" class="row g-2 align-items-end mb-4">
                <div class="col-12 col-md-5">
                    <label class="form-label" for="searchingString">Search</label>
                    <input id="searchingString" name="searchingString" value="@searchingString" class="form-control" placeholder="Customer name, phone number, or bill number" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" for="status">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All statuses</option>
                        @foreach (var rentalStatus in new[] { "Booked", "Active", "Returned", "Overdue", "Cancelled" })
                        {
                            <option value="@rentalStatus" selected="@(selectedStatus == rentalStatus)">@rentalStatus</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
                    <a asp-action="GetAllRentalCholiList" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            @* <th>Bill No</th> *@
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Rental Start</th>
                            <th>Expected Return</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="rental-row" role="button" tabindex="0" data-rental-id="@item.RentalId" title="Click to see booked cholis">
                                    <td><strong>#@item.RentalId</strong></td>
                                    @* <td>@item.</td> *@
                                    <td>@item.FirstName @item.LastName</td>
                                    <td>@item.PhoneNumber</td>
                                    <td>@item.RentalStartDate?.ToString("dd-MM-yyyy")</td>
                                    <td>@item.ExpectedReturnDate?.ToString("dd-MM-yyyy")</td>
                                    <td>
                                        @if (item.Status == "Booked")
                                        {
                                            <span class="badge bg-primary">Booked</span>
                                        }
                                        else if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="badge bg-secondary">Returned</span>
                                        }
                                        else if (item.Status == "Overdue")
                                        {
                                            <span class="badge bg-danger">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="DetailsRentalCholi" asp-route-id="@item.RentalId"
                                               class="btn btn-sm btn-info text-white" title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditRentalCholi" asp-route-id="@item.RentalId"
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="ManageRentalPayments" asp-route-id="@item.RentalId"
                                               class="btn btn-sm btn-success" title="Payments">
                                                <i class="bi bi-cash-stack"></i>
                                            </a>
                                            <form asp-action="DeleteRentalCholi" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to cancel this rental?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.RentalId" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Cancel">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No rental bookings found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rentalItemsModal" tabindex="-1" aria-labelledby="rentalItemsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="rentalItemsModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        const rentalItemsModal = document.getElementById('rentalItemsModal');
        const rentalItemsModalContent = document.getElementById('rentalItemsModalContent');

        async function showRentalItems(rentalId) {
            rentalItemsModalContent.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>';
            bootstrap.Modal.getOrCreateInstance(rentalItemsModal).show();

            try {
                const response = await fetch('@Url.Action("RentalItemsModal", "Rental")?id=' + encodeURIComponent(rentalId));
                if (!response.ok) throw new Error('Unable to load booked cholis.');
                rentalItemsModalContent.innerHTML = await response.text();
            } catch (error) {
                rentalItemsModalContent.innerHTML = '<div class="modal-body text-center text-danger py-5">Unable to load booked cholis.</div>';
            }
        }

        document.querySelectorAll('.rental-row').forEach(row => {
            row.addEventListener('click', event => {
                if (event.target.closest('a, button, form')) return;
                showRentalItems(row.dataset.rentalId);
            });
            row.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    showRentalItems(row.dataset.rentalId);
                }
            });
        });
    </script>
}
