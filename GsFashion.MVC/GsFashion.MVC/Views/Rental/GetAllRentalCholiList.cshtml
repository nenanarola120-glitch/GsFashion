@model IEnumerable<GsFashion.Repository.Models.Rental.RentalModel>

@{
    ViewData["Title"] = "Rentals";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Rentals</h3>
            <p class="text-muted mb-0">Manage rental bookings</p>
        </div>
        <a asp-action="AddRentalCholi" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Rental
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Booking Date</th>
                            <th>Rental Start</th>
                            <th>Expected Return</th>
                            <th>Grand Total</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.RentalId</strong></td>
                                    <td>@item.FirstName @item.LastName</td>
                                    <td>@item.PhoneNumber</td>
                                    <td>@item.BookingDate?.ToString("dd-MM-yyyy")</td>
                                    <td>@item.RentalStartDate?.ToString("dd-MM-yyyy")</td>
                                    <td>@item.ExpectedReturnDate?.ToString("dd-MM-yyyy")</td>
                                    <td>₹ @item.GrandTotal.ToString("N2")</td>
                                    <td>₹ @item.AmountPaid.ToString("N2")</td>
                                    <td>₹ @item.BalanceAmount.ToString("N2")</td>
                                    <td>
                                        @if (item.Status == "Booked")
                                        {
                                            <span class="badge bg-primary">Booked</span>
                                        }
                                        else if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="badge bg-secondary">Returned</span>
                                        }
                                        else if (item.Status == "Overdue")
                                        {
                                            <span class="badge bg-danger">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="DetailsRentalCholi" asp-route-id="@item.RentalId"
                                               class="btn btn-sm btn-info text-white" title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditRentalCholi" asp-route-id="@item.RentalId"
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="ManageRentalPayments" asp-route-id="@item.RentalId"
                                               class="btn btn-sm btn-success" title="Payments">
                                                <i class="bi bi-cash-stack"></i>
                                            </a>
                                            <form asp-action="DeleteRentalCholi" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to cancel this rental?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.RentalId" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Cancel">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No rental bookings found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
