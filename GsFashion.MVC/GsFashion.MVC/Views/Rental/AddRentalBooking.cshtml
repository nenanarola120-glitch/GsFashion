@model GsFashion.Repository.Models.Rental.RentalModel

@{
    ViewData["Title"] = "AddRentalBooking";
}

<style>
    .booking-header { background: linear-gradient(135deg, #172554, #2563eb); border-radius: 1rem; color: #fff; padding: 1.5rem; }
    .booking-header .text-muted { color: rgba(255,255,255,.72) !important; }
    .booking-card { border-radius: 1rem; overflow: hidden; }
    .booking-card .card-header { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 1rem 1.25rem; }
    .booking-card .card-body { padding: 1.25rem; }
    .booking-card .form-control, .booking-card .form-select { border-color: #dbe3ef; min-height: 2.7rem; }
    .booking-card .form-control:focus, .booking-card .form-select:focus { border-color: #60a5fa; box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .12); }
</style>

<div class="container-fluid">

    <!-- ========================================= HEADER ========================================== -->
    <div class="booking-header d-flex justify-content-between align-items-center mb-4 shadow-sm">
        <div>
            <h3 class="fw-bold mb-1">Create Rental</h3>
            <p class="text-muted mb-0">Complete booking details</p>
        </div>

        <a asp-action="AddRentalCholi" asp-route-itemIds="@Model.ItemIds" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Change Choli
        </a>
    </div>

    <form asp-action="AddRentalBooking" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- ========================================= SELECTED CHOLI ========================================== -->
        <div class="card booking-card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">Selected Choli</h5>
                        <small class="text-muted">Items included in this rental</small>
                    </div>

                    <span class="badge bg-primary">
                        @Model.InventoryItemModels.Count() Item(s)
                    </span>
                </div>
            </div>

            <div class="card-body">
                @if (!Model.InventoryItemModels.Any())
                {
                    <div class="alert alert-warning">
                        No choli selected.
                        <a asp-action="AddRentalCholi" class="alert-link">Select Choli</a>
                    </div>
                }
                else
                {
                    <div id="selectedItemsContainer" class="row g-3">
                        @foreach (var item in Model.InventoryItemModels)
                        {
                            <div class="col-md-6 col-lg-4" data-item-container="@item.ItemId">
                                <div class="border rounded p-3 bg-light">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@item.SkuCode</strong>
                                            <div>@item.Name</div>
                                            <small class="text-muted">
                                                @(item.CategoryName ?? "-") | Size: @(item.Size ?? "-") | Color: @(item.Color ?? "-")
                                                <br />
                                                Rent: ₹ @item.BaseRentalPrice.ToString("0.00") | Deposit: ₹ @item.SecurityDeposit.ToString("0.00")
                                            </small>
                                        </div>

                                        <button type="button" class="btn btn-sm btn-outline-danger remove-item" data-id="@item.ItemId">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Important -->
                <input asp-for="ItemIds" type="hidden" id="ItemIdsHidden" />
                <span asp-validation-for="ItemIds" class="text-danger"></span>
            </div>
        </div>

        <!-- ========================================= CUSTOMER DETAILS ========================================== -->
        <div class="card booking-card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Customer Details</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <!-- First Name -->
                    <div class="col-md-6">
                        <label asp-for="CustomerFirstName" class="form-label">
                            First Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CustomerFirstName" class="form-control" placeholder="Enter first name" />
                        <span asp-validation-for="CustomerFirstName" class="text-danger"></span>
                    </div>

                    <!-- Last Name -->
                    <div class="col-md-6">
                        <label asp-for="CustomerLastName" class="form-label">Last Name</label>
                        <input asp-for="CustomerLastName" class="form-control" placeholder="Enter last name" />
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label asp-for="CustomerPhoneNumber" class="form-label">
                            Phone Number <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CustomerPhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="CustomerPhoneNumber" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label asp-for="CustomerEmail" class="form-label">Email</label>
                        <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="Enter email" />
                    </div>

                    <!-- Address -->
                    <div class="col-md-12">
                        <label asp-for="CustomerAddress" class="form-label">Address</label>
                        <textarea asp-for="CustomerAddress" class="form-control" rows="3" placeholder="Enter customer address"></textarea>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========================================= RENTAL DETAILS ========================================== -->
        <div class="card booking-card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Rental Details</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <!-- Rental Start -->
                    <div class="col-md-6">
                        <label asp-for="RentalStartDate" class="form-label">
                            Rental Start Date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="RentalStartDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="RentalStartDate" class="text-danger"></span>
                    </div>

                    <!-- Expected Return -->
                    <div class="col-md-6">
                        <label asp-for="ExpectedReturnDate" class="form-label">
                            Expected Return Date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ExpectedReturnDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ExpectedReturnDate" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========================================= RENTAL CHARGES ========================================== -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Rental Charges</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <!-- Total Rent -->
                    <div class="col-md-4">
                        <label asp-for="TotalRentAmount" class="form-label">Total Rent Amount</label>
                        <input asp-for="TotalRentAmount" type="number" step="0.01" min="0" class="form-control" id="TotalRentAmount" />
                    </div>

                    <!-- Security Deposit -->
                    <div class="col-md-4">
                        <label asp-for="SecurityDeposit" class="form-label">Security Deposit</label>
                        <input asp-for="SecurityDeposit" type="number" step="0.01" min="0" class="form-control" id="SecurityDeposit" />
                    </div>

                    <!-- Discount -->
                    <div class="col-md-4">
                        <label asp-for="Discount" class="form-label">Discount</label>
                        <input asp-for="Discount" type="number" step="0.01" min="0" class="form-control" id="Discount" />
                    </div>

                    <!-- Grand Total -->
                    <div class="col-md-4">
                        <label asp-for="GrandTotal" class="form-label">Grand Total</label>
                        <input asp-for="GrandTotal" type="number" step="0.01" min="0" class="form-control" id="GrandTotal" readonly />
                    </div>

                    <!-- Amount Paid -->
                    <div class="col-md-6">
                        <label asp-for="AmountPaid" class="form-label">Amount Paid</label>
                        <input asp-for="AmountPaid" type="number" step="0.01" min="0" class="form-control" id="AmountPaid" />
                    </div>

                    <!-- Balance -->
                    <div class="col-md-6">
                        <label asp-for="BalanceAmount" class="form-label">Balance Amount</label>
                        <input asp-for="BalanceAmount" type="number" step="0.01" class="form-control" id="BalanceAmount" readonly />
                    </div>

                    <!-- Notes -->
                    <div class="col-md-12">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Enter notes"></textarea>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========================================= BUTTONS ========================================== -->
        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-action="AddRentalCholi" asp-route-itemIds="@Model.ItemIds" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Change Choli
            </a>

            <a asp-action="GetAllRentalCholiList" class="btn btn-light border">Cancel</a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Book Choli
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ==========================================
        // Calculate Grand Total
        // Total Rent + Security Deposit - Discount
        // ==========================================
        function calculateGrandTotal() {
            const rent = parseFloat(document.getElementById("TotalRentAmount").value) || 0;
            const deposit = parseFloat(document.getElementById("SecurityDeposit").value) || 0;
            const discount = parseFloat(document.getElementById("Discount").value) || 0;

            const grandTotal = rent + deposit - discount;

            document.getElementById("GrandTotal").value = Math.max(grandTotal, 0).toFixed(2);

            calculateBalance();
        }

        // ==========================================
        // Calculate Balance
        // ==========================================
        function calculateBalance() {
            const grandTotal = parseFloat(document.getElementById("GrandTotal").value) || 0;
            const amountPaid = parseFloat(document.getElementById("AmountPaid").value) || 0;

            const balance = grandTotal - amountPaid;

            document.getElementById("BalanceAmount").value = Math.max(balance, 0).toFixed(2);
        }

        // ==========================================
        // Charge Events
        // ==========================================
        document.querySelectorAll(".form-control").forEach(function (element) {
            if (
                element.id === "TotalRentAmount" ||
                element.id === "SecurityDeposit" ||
                element.id === "Discount"
            ) {
                element.addEventListener("input", calculateGrandTotal);
            }
        });

        document.getElementById("AmountPaid").addEventListener("input", calculateBalance);

        // Keep the expected return date on or after the selected rental start date.
        const rentalStartDate = document.getElementById("RentalStartDate");
        const expectedReturnDate = document.getElementById("ExpectedReturnDate");
        rentalStartDate.addEventListener("change", function () {
            expectedReturnDate.min = rentalStartDate.value;
            if (expectedReturnDate.value && expectedReturnDate.value < rentalStartDate.value) {
                expectedReturnDate.value = rentalStartDate.value;
            }
        });
        rentalStartDate.dispatchEvent(new Event("change"));

        // ==========================================
        // Remove Selected Item
        // ==========================================
        document.querySelectorAll(".remove-item").forEach(function (button) {
            button.addEventListener("click", function () {
                const id = parseInt(this.dataset.id);
                const hiddenField = document.getElementById("ItemIdsHidden");

                let ids = hiddenField.value
                    .split(",")
                    .filter(function (x) { return x.trim() !== ""; })
                    .map(function (x) { return parseInt(x); });

                // Remove ID
                ids = ids.filter(function (itemId) { return itemId !== id; });

                // Update hidden field
                hiddenField.value = ids.join(",");

                // Remove UI
                const container = document.querySelector(`[data-item-container="${id}"]`);
                if (container) {
                    container.remove();
                }

                // If nothing remains
                if (ids.length === 0) {
                    window.location.href = '@Url.Action("AddRentalCholi", "Rental")';
                }
            });
        });
    </script>
}
