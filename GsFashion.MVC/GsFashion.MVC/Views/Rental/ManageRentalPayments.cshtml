@model GsFashion.Repository.Models.Rental.RentalPaymentPageModel
@{
    ViewData["Title"] = "Rental Payments";
    var today = DateTime.Today;
    var depositPaid = Model.Payments.Any(p => p.PaymentType == "Deposit");
    var rentPaid = Model.Payments.Any(p => p.PaymentType == "Rent");
    var depositRefunded = Model.Payments.Any(p => p.PaymentType == "DepositRefund");
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h3 class="fw-bold mb-1">Rental Payment #@Model.Rental.RentalId</h3><p class="text-muted mb-0">@Model.Rental.FirstName @Model.Rental.LastName</p></div>
        <a asp-action="GetAllRentalCholiList" class="btn btn-secondary">Back</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Deposit at booking</small><h4 class="mb-2">₹ @Model.Rental.SecurityDeposit.ToString("N2")</h4><span class="badge @(depositPaid ? "bg-success" : "bg-secondary")">@(depositPaid ? "Paid" : "Pending")</span></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Rent due from @Model.Rental.RentalStartDate?.ToString("dd MMM yyyy")</small><h4 class="mb-2">₹ @Math.Max(Model.Rental.TotalRentAmount - Model.Rental.Discount, 0).ToString("N2")</h4><span class="badge @(rentPaid ? "bg-success" : "bg-warning text-dark")">@(rentPaid ? "Paid" : "Due")</span></div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><small class="text-muted">Deposit refund after return</small><h4 class="mb-2">₹ @Model.Rental.SecurityDeposit.ToString("N2")</h4><span class="badge @(depositRefunded ? "bg-success" : "bg-secondary")">@(depositRefunded ? "Refunded" : "Pending return")</span></div></div></div>
    </div>
    <div class="card border-0 shadow-sm"><div class="card-header bg-white"><h5 class="mb-0">Admin actions</h5></div><div class="card-body">
        @if (!rentPaid && Model.Rental.RentalStartDate <= today)
        { <form asp-action="RecordRentalPayment" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="rentalId" value="@Model.Rental.RentalId" /><input type="hidden" name="paymentType" value="Rent" /><button class="btn btn-primary">Collect Rental Amount</button></form> }
        @if (rentPaid && !depositRefunded)
        { <form asp-action="RecordRentalPayment" method="post" class="row g-2 mt-1">@Html.AntiForgeryToken()<input type="hidden" name="rentalId" value="@Model.Rental.RentalId" /><input type="hidden" name="paymentType" value="DepositRefund" /><div class="col-md-4"><input name="actualReturnDate" type="date" value="@today.ToString("yyyy-MM-dd")" class="form-control" required /></div><div class="col-md-5"><input name="notes" class="form-control" placeholder="Refund note (optional)" /></div><div class="col-md-3"><button class="btn btn-success w-100">Return Deposit</button></div></form> }
    </div></div>
</div>
