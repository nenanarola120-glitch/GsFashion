@model IEnumerable<GsFashion.Repository.Models.RoleMenuPermissionModel>
@{
    ViewData["Title"] = "Role Menu Permissions";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="m-0">Role Menu Permissions</h4>
    <a asp-action="Create" class="btn btn-dark btn-sm">+ New Permission</a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success py-2">@successMessage</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Role</th>
                <th>Menu</th>
                <th class="text-center">View</th>
                <th class="text-center">Add</th>
                <th class="text-center">Edit</th>
                <th class="text-center">Delete</th>
                <th style="width: 140px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RoleName</td>
                    <td>@item.MenuName</td>
                    <td class="text-center">@(item.CanView ? "✔" : "—")</td>
                    <td class="text-center">@(item.CanAdd ? "✔" : "—")</td>
                    <td class="text-center">@(item.CanEdit ? "✔" : "—")</td>
                    <td class="text-center">@(item.CanDelete ? "✔" : "—")</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.PermissionId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.PermissionId" method="post"
                                  onsubmit="return confirm('Delete this permission entry?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">No permissions configured yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
