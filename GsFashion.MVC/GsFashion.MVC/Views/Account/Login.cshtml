@model GsFashion.MVC.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login - GS Fashion Admin";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <style>

        /* =====================================================
                   PAGE
                   ===================================================== */

        body {
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
        }


        /* =====================================================
                   TOAST CONTAINER
                   ===================================================== */

        .custom-toast-container {
            position: fixed;
            top: 20px;
            right: 12px;
            z-index: 99999;
        }


        /* =====================================================
                   MAIN TOAST
                   ===================================================== */

        .custom-toast {
            width: 375px;
            min-height: 84px;
            background: #ffffff;
            border-radius: 7px;
            display: flex;
            align-items: center;
            padding: 14px 14px 14px 16px;
            position: relative;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            animation: toastSlideIn 0.35s ease-out;
        }


        /* =====================================================
                   SUCCESS TOAST
                   ===================================================== */

        .toast-success {
            border-left: 5px solid #22c55e;
        }

            .toast-success .toast-icon {
                background-color: #3bd16f;
            }


        /* =====================================================
                   ERROR TOAST
                   ===================================================== */

        .toast-error {
            border-left: 5px solid #ef4444;
        }

            .toast-error .toast-icon {
                background-color: #ef4444;
            }


        /* =====================================================
                   TOAST ICON
                   ===================================================== */

        .toast-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 25px;
            font-weight: 600;
            margin-right: 15px;
        }


        /* =====================================================
                   TOAST CONTENT
                   ===================================================== */

        .toast-content {
            flex: 1;
            padding-right: 25px;
        }


        /* =====================================================
                   TOAST TITLE
                   ===================================================== */

        .toast-title {
            font-size: 16px;
            font-weight: 700;
            color: #222222;
            margin-bottom: 4px;
        }


        /* =====================================================
                   TOAST MESSAGE
                   ===================================================== */

        .toast-message {
            font-size: 14px;
            color: #777777;
            line-height: 1.4;
            word-break: break-word;
        }


        /* =====================================================
                   CLOSE BUTTON
                   ===================================================== */

        .toast-close {
            position: absolute;
            top: 9px;
            right: 10px;
            width: 25px;
            height: 25px;
            border: none;
            background: transparent;
            color: #777777;
            font-size: 20px;
            line-height: 20px;
            cursor: pointer;
            padding: 0;
            transition: color 0.2s ease;
        }


            .toast-close:hover {
                color: #222222;
            }


        /* =====================================================
                   SLIDE IN ANIMATION
                   ===================================================== */

        @@keyframes toastSlideIn {

            from {
                opacity: 0;
                transform: translateX(40px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }


        /* =====================================================
                   FADE OUT ANIMATION
                   ===================================================== */

        @@keyframes toastFadeOut {

            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(40px);
            }
        }


        /* =====================================================
                   LOGIN PAGE
                   ===================================================== */

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        .login-card {
            width: 380px;
            background: #ffffff;
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }


        /* =====================================================
                   MOBILE
                   ===================================================== */

        @@media (max-width: 576px) {

            .custom-toast-container {
                top: 15px;
                right: 10px;
                left: 10px;
            }

            .custom-toast {
                width: 100%;
            }

            .login-card {
                width: calc(100% - 30px);
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         SUCCESS TOAST
         ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="custom-toast-container">

            <div class="custom-toast toast-success"
                 id="successToast">

                <!-- Success Icon -->
                <div class="toast-icon">
                    ✓
                </div>


                <!-- Content -->
                <div class="toast-content">

                    <div class="toast-title">
                        Success
                    </div>

                    <div class="toast-message">
                        @TempData["Success"]
                    </div>

                </div>


                <!-- Close -->
                <button type="button"
                        class="toast-close"
                        onclick="closeToast('successToast')">

                    ×

                </button>

            </div>

        </div>
    }


    <!-- =====================================================
         ERROR TOAST
         ===================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="custom-toast-container">

            <div class="custom-toast toast-error"
                 id="errorToast">

                <!-- Error Icon -->
                <div class="toast-icon">
                    !
                </div>


                <!-- Content -->
                <div class="toast-content">

                    <div class="toast-title">
                        Error
                    </div>

                    <div class="toast-message">
                        @TempData["Error"]
                    </div>

                </div>


                <!-- Close -->
                <button type="button"
                        class="toast-close"
                        onclick="closeToast('errorToast')">

                    ×

                </button>

            </div>

        </div>
    }


    <!-- =====================================================
         LOGIN PAGE
         ===================================================== -->

    <div class="login-wrapper">

        <div class="card login-card">

            <div class="card-body p-4">


                <!-- Title -->

                <h4 class="mb-1 text-center">
                    GS Fashion
                </h4>


                <p class="text-muted text-center mb-4">
                    Admin Login
                </p>


                <!-- =================================================
                     LOGIN FORM
                     ================================================= -->

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">


                    <!-- Return URL -->

                    <input type="hidden"
                           asp-for="ReturnUrl" />


                    <!-- =================================================
                         USERNAME
                         ================================================= -->

                    <div class="mb-3">

                        <label asp-for="Username"
                               class="form-label">
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               autofocus />

                        <span asp-validation-for="Username"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         PASSWORD
                         ================================================= -->

                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label">
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         LOGIN BUTTON
                         ================================================= -->

                    <button type="submit"
                            class="btn btn-dark w-100">

                        Login

                    </button>


                </form>


                <!-- =================================================
                     REGISTER
                     ================================================= -->

                <p class="text-center text-muted mt-3 mb-0 small">

                    New here?

                    <a asp-controller="Account"
                       asp-action="Register">

                        Create an account

                    </a>

                </p>


            </div>

        </div>

    </div>


    <!-- =====================================================
         TOAST JAVASCRIPT
         ===================================================== -->

    <script>

        /* =================================================
           CLOSE TOAST
           ================================================= */

        function closeToast(toastId) {

            const toast =
                document.getElementById(toastId);

            if (toast) {

                toast.style.animation =
                    "toastFadeOut 0.3s ease forwards";


                setTimeout(function () {

                    toast.remove();

                }, 300);

            }

        }


        /* =================================================
           AUTO HIDE TOAST
           ================================================= */

        setTimeout(function () {

            const successToast =
                document.getElementById("successToast");

            const errorToast =
                document.getElementById("errorToast");


            if (successToast) {

                closeToast("successToast");

            }


            if (errorToast) {

                closeToast("errorToast");

            }

        }, 4000);

    </script>


</body>

</html>