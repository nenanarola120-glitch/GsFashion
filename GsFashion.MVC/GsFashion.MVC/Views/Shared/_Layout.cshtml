<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - GS Fashion Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar: built dynamically from role_menu_permissions via SidebarMenu ViewComponent -->
        <nav class="admin-sidebar bg-dark text-white p-3">
            <h5 class="mb-4">GS Fashion</h5>
            @await Component.InvokeAsync("SidebarMenu")
        </nav>

        <div class="flex-grow-1">
            <header class="d-flex justify-content-between align-items-center border-bottom p-3">
                <span class="fw-semibold">@ViewData["Title"]</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <span class="me-2 text-muted">@User.FindFirst("FullName")?.Value</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                </form>
            </header>

            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
