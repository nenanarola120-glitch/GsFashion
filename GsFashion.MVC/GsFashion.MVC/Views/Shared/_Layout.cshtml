<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - GS Fashion Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar: built dynamically from role_menu_permissions via SidebarMenu ViewComponent -->
        <nav class="admin-sidebar bg-dark text-white p-3">
            <h5 class="mb-4">GS Fashion</h5>
            @await Component.InvokeAsync("SidebarMenu")
        </nav>

        <div class="flex-grow-1">
            <header class="d-flex justify-content-between align-items-center border-bottom p-3">
                <span class="fw-semibold">@ViewData["Title"]</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <span class="me-2 text-muted">@User.FindFirst("FullName")?.Value</span>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                </form>
            </header>

            <main class="p-4">
                @RenderBody()

                <!-- Toast Container -->
                <div id="toastContainer">

                    @if (TempData["Success"] != null)
                    {
                        <div class="custom-toast toast-success">
                            <div class="toast-icon">
                                ✓
                            </div>

                            <div class="toast-content">
                                <div class="toast-title">Success</div>
                                <div class="toast-message">@TempData["Success"]</div>
                            </div>

                            <button type="button" class="toast-close" onclick="closeToast(this)">
                                ×
                            </button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="custom-toast toast-error">
                            <div class="toast-icon">
                                ×
                            </div>

                            <div class="toast-content">
                                <div class="toast-title">Error</div>
                                <div class="toast-message">@TempData["Error"]</div>
                            </div>

                            <button type="button" class="toast-close" onclick="closeToast(this)">
                                ×
                            </button>
                        </div>
                    }

                </div>
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const toasts = document.querySelectorAll(".custom-toast");

        toasts.forEach(function (toast) {

            // Automatically close after 4 seconds
            setTimeout(function () {
                closeToast(toast.querySelector(".toast-close"));
            }, 4000);

        });

    });


    function closeToast(button) {

        const toast = button.closest(".custom-toast");

        if (!toast)
            return;

        toast.style.animation = "toastSlideOut 0.4s ease forwards";

        setTimeout(function () {
            toast.remove();
        }, 400);

    }

</script>
</body>
</html>
