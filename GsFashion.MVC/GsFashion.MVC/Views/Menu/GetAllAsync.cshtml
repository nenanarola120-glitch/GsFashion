@model IEnumerable<GsFashion.Repository.Models.MenuModel>

@{
    ViewData["Title"] = "Menu Master";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="mb-0">
            Menu Master
        </h3>

        <a asp-controller="Menu"
           asp-action="AddMenu"
           class="btn btn-primary">

            <i class="fa fa-plus"></i>
            Add Menu

        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card">

        <div class="card-header">
            <strong>Menu List</strong>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Menu Name</th>
                            <th>Parent Menu</th>
                            <th>URL</th>
                            <th>Icon</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var menu in Model)
                            {
                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        <strong>
                                            @menu.MenuName
                                        </strong>
                                    </td>

                                    <td>

                                        @if (menu.ParentMenuId.HasValue)
                                        {
                                            var parentMenu = Model
                                            .FirstOrDefault(x =>
                                            x.MenuId == menu.ParentMenuId.Value);

                                            @if (parentMenu != null)
                                            {
                                                @parentMenu.MenuName
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    -
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                Main Menu
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.MenuUrl))
                                        {
                                            @menu.MenuUrl
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrEmpty(menu.IconClass))
                                        {
                                            <i class="@menu.IconClass"></i>
                                            @menu.IconClass
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @menu.DisplayOrder
                                    </td>

                                    <td>

                                        @if (menu.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Menu"
                                           asp-action="EditMenu"
                                           asp-route-id="@menu.MenuId"
                                           class="btn btn-sm btn-warning">

                                            <i class="fa fa-edit"></i>
                                            Edit

                                        </a>


                                        <form asp-controller="Menu"
                                              asp-action="DeleteMenu"
                                              asp-route-id="@menu.MenuId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this menu?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">

                                                <i class="fa fa-trash"></i>
                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center text-muted">

                                    No menu found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>