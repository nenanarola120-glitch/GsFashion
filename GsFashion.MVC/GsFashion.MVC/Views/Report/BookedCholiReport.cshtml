@model GsFashion.MVC.Models.BookedCholiReportViewModel

@{
    ViewData["Title"] = "Booked Choli Report";
    var choliGroups = Model.Items
        .GroupBy(item => new { item.ItemId, item.SkuCode, item.Name })
        .OrderByDescending(group => group.Count())
        .ThenBy(group => group.Key.SkuCode)
        .ToList();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Booked Choli Report</h3>
            <p class="text-muted mb-0">View the number of bookings for each choli by rental start date.</p>
        </div>
        <a asp-action="AvailableCholiReport" class="btn btn-outline-primary">Available Cholis</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="BookedCholiReport" method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label asp-for="FromDate" class="form-label">From Date</label>
                    <input asp-for="FromDate" type="date" class="form-control" required />
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="ToDate" class="form-label">To Date</label>
                    <input asp-for="ToDate" type="date" class="form-control" required />
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="ItemId" class="form-label">Choli Name</label>
                    <select asp-for="ItemId" class="form-select">
                        <option value="">All cholis</option>
                        @foreach (var choli in Model.CholiOptions)
                        {
                            <option value="@choli.ItemId">@choli.SkuCode - @choli.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> View Report</button>
                    <a asp-action="BookedCholiReport" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.FromDate.HasValue)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Bookings from @Model.FromDate.Value.ToString("dd-MM-yyyy") to @Model.ToDate!.Value.ToString("dd-MM-yyyy")</h5>
                <span class="badge bg-primary rounded-pill">@Model.Items.Count() booking(s)</span>
            </div>
            <div class="card-body">
                @if (choliGroups.Any())
                {
                    @foreach (var choliGroup in choliGroups)
                    {
                        <div class="border rounded-3 mb-3 overflow-hidden">
                            <div class="bg-light px-3 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">@choliGroup.Key.SkuCode</span>
                                    <span class="text-muted mx-1">—</span>
                                    <span>@choliGroup.Key.Name</span>
                                </div>
                                <span class="badge bg-primary">@choliGroup.Count() booking(s)</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead><tr><th class="ps-3">Bill No.</th><th>Customer Name</th><th>Mobile Number</th></tr></thead>
                                    <tbody>
                                        @foreach (var booking in choliGroup)
                                        {
                                            <tr><td class="ps-3 fw-semibold">@booking.BillNo</td><td>@booking.CustomerName</td><td>@booking.MobileNumber</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">No choli bookings found for the selected dates.</div>
                }
            </div>
        </div>
    }
</div>
