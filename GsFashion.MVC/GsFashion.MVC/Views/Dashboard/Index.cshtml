@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<h3>Welcome, @User.FindFirst("FullName")?.Value</h3>
<p class="text-muted">Your role: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Active Rentals</div>
            <div class="fs-3 fw-bold">--</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Inventory Items</div>
            <div class="fs-3 fw-bold">--</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Customers</div>
            <div class="fs-3 fw-bold">--</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Overdue Returns</div>
            <div class="fs-3 fw-bold">--</div>
        </div>
    </div>
</div>
